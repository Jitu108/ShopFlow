{
  "info": {
    "name": "ShopFlow - Vendor Onboarding Flow",
    "description": "Self-contained flow: register a new vendor, promote to the Vendor role via the seeded admin, log in as the vendor, and create a product under that vendor. Independent of ShopFlow.postman_collection.json - run this collection on its own with either the Local Dev or Docker Compose environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Vendor Onboarding",
      "item": [
        {
          "name": "Admin: Login (seeded)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityBaseUrl}}/api/auth/login",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin Login - status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Admin Login - response matches schema', () => {",
                  "  pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"accessToken\",\"refreshToken\",\"email\",\"displayName\",\"role\"],\"properties\":{\"accessToken\":{\"type\":\"string\",\"minLength\":1},\"refreshToken\":{\"type\":\"string\",\"minLength\":1},\"email\":{\"type\":\"string\"},\"displayName\":{\"type\":\"string\"},\"role\":{\"type\":\"string\",\"enum\":[\"Customer\",\"Vendor\",\"Admin\"]}}});",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Admin Login - role is Admin', () => pm.expect(json.role).to.eql('Admin'));",
                  "pm.collectionVariables.set('adminToken', json.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Vendor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityBaseUrl}}/api/auth/register",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vendorEmail}}\",\n  \"password\": \"{{vendorPassword}}\",\n  \"displayName\": \"New Vendor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('vendorEmail', 'vendor.' + Date.now() + '.' + Math.floor(Math.random() * 100000) + '@shopflow.test');",
                  "pm.collectionVariables.set('vendorPassword', 'Passw0rd!1');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register Vendor - status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Register Vendor - response matches schema', () => {",
                  "  pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"accessToken\",\"refreshToken\",\"email\",\"displayName\",\"role\"],\"properties\":{\"accessToken\":{\"type\":\"string\",\"minLength\":1},\"refreshToken\":{\"type\":\"string\",\"minLength\":1},\"email\":{\"type\":\"string\"},\"displayName\":{\"type\":\"string\"},\"role\":{\"type\":\"string\",\"enum\":[\"Customer\",\"Vendor\",\"Admin\"]}}});",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Register Vendor - default role is Customer (not yet promoted)', () => {",
                  "  pm.expect(json.role).to.eql('Customer');",
                  "});",
                  "function b64urlDecode(str) {",
                  "  str = str.replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (str.length % 4) { str += '='; }",
                  "  return JSON.parse(atob(str));",
                  "}",
                  "const claims = b64urlDecode(json.accessToken.split('.')[1]);",
                  "pm.collectionVariables.set('vendorId', claims.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin: Assign Vendor Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{identityBaseUrl}}/api/admin/users/{{vendorId}}/assign-role",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "{{vendorId}}",
                "assign-role"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Vendor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Assign Vendor Role - status is success (200 or 204)', () => {",
                  "  pm.expect([200, 204]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Vendor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityBaseUrl}}/api/auth/login",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vendorEmail}}\",\n  \"password\": \"{{vendorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login Vendor - status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Login Vendor - response matches schema', () => {",
                  "  pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"accessToken\",\"refreshToken\",\"email\",\"displayName\",\"role\"],\"properties\":{\"accessToken\":{\"type\":\"string\",\"minLength\":1},\"refreshToken\":{\"type\":\"string\",\"minLength\":1},\"email\":{\"type\":\"string\"},\"displayName\":{\"type\":\"string\"},\"role\":{\"type\":\"string\",\"enum\":[\"Customer\",\"Vendor\",\"Admin\"]}}});",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Login Vendor - role updated to Vendor', () => pm.expect(json.role).to.eql('Vendor'));",
                  "pm.collectionVariables.set('vendorToken', json.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "url": {
              "raw": "{{productBaseUrl}}/api/products",
              "host": [
                "{{productBaseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Onboarding Test Product\",\n  \"description\": \"Created by the vendor onboarding flow\",\n  \"price\": 29.99,\n  \"stockQuantity\": 25,\n  \"categoryId\": \"{{categoryId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(async () => {",
                  "  const list = await pm.sendRequest({",
                  "    url: pm.variables.replaceIn('{{productBaseUrl}}/api/categories'),",
                  "    method: 'GET'",
                  "  });",
                  "  const categories = list.json();",
                  "  if (Array.isArray(categories) && categories.length > 0) {",
                  "    pm.collectionVariables.set('categoryId', categories[0].id);",
                  "    return;",
                  "  }",
                  "  const created = await pm.sendRequest({",
                  "    url: pm.variables.replaceIn('{{productBaseUrl}}/api/categories'),",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('adminToken') },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ name: 'Vendor Onboarding Category ' + Date.now() }) }",
                  "  });",
                  "  pm.collectionVariables.set('categoryId', created.json().id);",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create Product - status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Create Product - response matches schema', () => {",
                  "  pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"id\",\"vendorId\",\"name\",\"description\",\"price\",\"stockQuantity\",\"isActive\",\"categoryId\",\"createdAt\",\"updatedAt\"],\"properties\":{\"id\":{\"type\":\"string\"},\"vendorId\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"price\":{\"type\":\"number\"},\"stockQuantity\":{\"type\":\"integer\"},\"isActive\":{\"type\":\"boolean\"},\"categoryId\":{\"type\":\"string\"},\"createdAt\":{\"type\":\"string\"},\"updatedAt\":{\"type\":\"string\"}}});",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Create Product - vendorId matches the newly onboarded vendor', () => {",
                  "  pm.expect(json.vendorId).to.eql(pm.collectionVariables.get('vendorId'));",
                  "});",
                  "pm.test('Create Product - price and stock echo request', () => {",
                  "  pm.expect(json.price).to.eql(29.99);",
                  "  pm.expect(json.stockQuantity).to.eql(25);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "adminEmail",
      "value": "admin@shopflow.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin@12345"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "vendorEmail",
      "value": ""
    },
    {
      "key": "vendorPassword",
      "value": ""
    },
    {
      "key": "vendorToken",
      "value": ""
    },
    {
      "key": "vendorId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    }
  ]
}

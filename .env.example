# SQL Server
SQL_SA_PASSWORD=YourStrong@Password123

# JWT — use a long random string (32+ chars)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# SMTP (for Notification Service)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@shopflow.com
SMTP_PASSWORD=your-smtp-password

# monday.com (ShopFlow board — used by the monday-ticket skill)
MONDAY_BOARD_URL=https://your-team.monday.com/boards/0000000000
MONDAY_BOARD_ID=0000000000
